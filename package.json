{
  "name": "termenv",
  "version": "1.0.5",
  "description": "Terminal Environment Utilities",
  "keywords": [
    "ansi",
    "cli",
    "color",
    "color-support",
    "detection",
    "environment",
    "hyperlinks",
    "terminal",
    "truecolor",
    "tty",
    "unicode"
  ],
  "homepage": "https://github.com/luxass/termenv",
  "bugs": {
    "url": "https://github.com/luxass/termenv/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/termenv.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./supports": "./dist/supports.mjs",
    "./utils": "./dist/utils.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:bun": "bun test ./test-bun",
    "typecheck": "tsc --noEmit && tsc --noEmit --project test-bun/tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "catalog:types",
    "@types/node": "catalog:types",
    "@vitest/browser": "catalog:testing",
    "@vitest/browser-playwright": "catalog:testing",
    "@vitest/coverage-v8": "catalog:testing",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "playwright": "catalog:testing",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:testing"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@12.11.2"
}
